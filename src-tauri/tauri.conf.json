{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "reserve-app",
  "version": "0.1.0",
  "identifier": "com.reserveapp.massage",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "appDirectoriesOverride": "./atlas-massage",
    "windows": [
      {
        "title": "Atlas Massage",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:massage.db"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Massage salon appointment management",
    "longDescription": "Desktop appointment management application for massage salons",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}